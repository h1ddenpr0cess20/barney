{
  "name": "barney",
  "version": "0.1.0",
  "private": true,
  "description": "A voice agent rendered as a bowling ball, driven by an OpenAI GPT-Live conversation",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "preview": "npm run build && npm start",
    "preview:lan": "npm run build && npm start -- --https",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "madness-engine": "git+https://github.com/h1ddenpr0cess20/madness-engine.git#0e8909c9078b41c5634c7a8ec4835fd787d1a28f",
    "vite": "^8.3.4"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
